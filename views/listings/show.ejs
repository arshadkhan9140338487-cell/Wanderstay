<% layout("/layouts/boilerplate") %>
<div class="row">
    <div class="col-10">
    <h3 class="mt-3">Listing Details:</h3>
    <div class="card mb-3 col-10">
  <img src="<%= listing.image %>" class="card-img-top show-image" alt="listing-image">
 </div>
  <div class="card-body col-10">
    <h4 class="card-title"><%= listing.title %></h4>
    <p class="card-text"><%= listing.description %></p>
    <p>
        <b>&#8377;<%= listing.price.toLocaleString("en-IN")%>/night</b> <br>
        <%= listing.location %> <br>
        <%= listing.country %>
    </p>
</div>
<div class="show-btns mt-2">
     <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn me-4">Edit details</a>
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button class="btn btn-dark del-btn">Delete</button>
    </form>
</div>
</div>
</div>
