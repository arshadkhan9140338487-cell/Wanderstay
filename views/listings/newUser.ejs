<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Listing</title>
</head>
<body>
    <h3>New listing details</h3>
    <form action="/listings" method="POST">
        Title:
        <input type="text" name="listing[title]" placeholder="Enter title here.">
        <br><br>
        Description:
        <textarea name="listing[description]" id="" placeholder="Write description here."></textarea>
        <br><br>
        Image:
        <input type="text" name="listing[image]" placeholder="Enter image URL/Link here.">
        <br><br>
        Price:
        <input type="number" name="listing[price]" placeholder="Enter price here.">
        <br><br>
        Location:
        <input type="text" name="listing[location]" placeholder="Enter location here,">
        <br><br>
        Country:
        <input type="text" name="listing[country]" id="" placeholder="Enter country name here.">
        <br><br>
        <button>Create Listing</button>
    </form>
</body>
</html>