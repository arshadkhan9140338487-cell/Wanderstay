<% layout("/layouts/boilerplate") %>
<body>
  <div class="row row-clos-lg-3 row-cols-md-2 row-cols-sm-1" >
    <h3>All Listings</h3>
    <%for(listing of allListings){ %>
    <section class="card" style="width: 20rem"> 
     <a href="/listings/<%= listing._id %>" class="listing-link">
  <img src="<%= listing.image %>" class="card-img-top" alt="listing_image" style="height: 20rem">
  <div class="card-img-overlay"></div>
  <div class="card-body">
    <h4 class="card-title"><i><%=listing.title %></i></h4>
    <p class="card-text">&#8377;<%= listing.price.toLocaleString("en-IN")%>/night</p>
  </div>
    </a>
</section>

   <%}%>
   </div>
</body>

